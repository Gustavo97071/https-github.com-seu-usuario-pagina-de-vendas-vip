{
  "version": 2,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "verificacao.html",
      "use": "@vercel/static"
    },
    {
      "src": "acesso-liberado.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static"
    },
    {
      "src": "*.mp4",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/create-pix",
      "dest": "/api/create-pix.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
